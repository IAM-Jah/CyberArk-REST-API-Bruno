meta {
  name: Get Download Package URL
  type: http
  seq: 3
}

get {
  url: https://{{EPMAddress}}/EPM/API/:version/Sets/:setID/Computers/Packages/:packageID/URL
  body: none
  auth: bearer
}

params:path {
  packageID: packageID
  setID: setID
  version: version
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{EPMToken}}
}
