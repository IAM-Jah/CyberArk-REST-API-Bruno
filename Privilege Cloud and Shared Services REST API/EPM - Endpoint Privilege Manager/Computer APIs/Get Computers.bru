meta {
  name: Get Computers
  type: http
  seq: 2
}

get {
  url: https://{{EPMAddress}}/EPM/API/:version/Sets/:setID/Computers
  body: none
  auth: bearer
}

params:query {
  ~ComputerName: eq 'comp01'
  ~Platform: eq 'MacOS'
  ~Status: in('Disconnected', 'Support')
  ~ActiveSessions: 'admin'
  ~LastSeendate: YYYY-MM-DDThh:mm:ssZ
  ~offset: integer
  ~limit: integer
}

params:path {
  setID: setID
  version: version
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{EPMToken}}
}
