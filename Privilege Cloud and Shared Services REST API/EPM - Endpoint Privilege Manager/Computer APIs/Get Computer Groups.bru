meta {
  name: Get Computer Groups
  type: http
  seq: 1
}

get {
  url: https://{{EPMAddress}}/EPM/API/:version/Sets/:setID/ComputerGroups
  body: none
  auth: bearer
}

params:query {
  ~$filter: contains(Name,'MyGroup')
}

params:path {
  setID: setID
  version: version
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{EPMToken}}
}
