meta {
  name: Create Agent Configuration Policy
  type: http
  seq: 1
}

post {
  url: https://{{EPMAddress}}/EPM/API/:version/Sets/:setID/AgentConfiguration
  body: json
  auth: bearer
}

params:path {
  setID: setID
  version: version
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{EPMToken}}
}

