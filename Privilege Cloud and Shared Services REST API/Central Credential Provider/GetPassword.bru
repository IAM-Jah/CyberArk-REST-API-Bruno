meta {
  name: GetPassword
  type: http
  seq: 1
}

get {
  url: https://{{CCPAddress}}/AIMWebService/api/Accounts?AppID={{appID}}&Safe={{safeName}}
  body: none
  auth: none
}

params:query {
  AppID: {{appID}}
  Safe: {{safeName}}
  ~Object: {{accountName}}
  ~UserName: string
  ~Address: string
  ~Database: string
  ~PolicyID: string
  ~Reason: string
  ~ConnectionTimeout: 30
  ~Query: string
  ~QueryFormat: Exact/Regexp
  ~FailRequestOnPasswordChange: True
  ~Folder: string
}

headers {
  Content-Type: application/json
}

tests {
  const data = res.getBody().Result
  
  test("Store secret as environment variable", function() {
      if (data.Content) {
          bru.setEnvVar("CCPRetrievedSecret", data.Content);
      }
  });
}
