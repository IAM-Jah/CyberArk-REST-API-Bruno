meta {
  name: Delete Network
  type: http
  seq: 8
}

delete {
  url: https://{{subdomain}}.cyberark.cloud/private/networks/:networkID
  body: none
  auth: bearer
}

params:path {
  networkID: networkID
}

headers {
  Content-Type: application/json
  tenant-id: tenant-id
}

auth:bearer {
  token: {{identityToken}}
}
