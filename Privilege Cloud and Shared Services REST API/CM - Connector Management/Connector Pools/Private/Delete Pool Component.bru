meta {
  name: Delete Pool Component
  type: http
  seq: 18
}

delete {
  url: https://{{subdomain}}.cyberark.cloud/private/pools/:poolID/components/:componentID
  body: none
  auth: bearer
}

params:path {
  componentID: componentID
  poolID: poolID
}

headers {
  Content-Type: application/json
  tenant-id: tenant-id
}

auth:bearer {
  token: {{identityToken}}
}
