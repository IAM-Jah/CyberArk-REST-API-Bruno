meta {
  name: Get Available Connector Pools
  type: http
  seq: 2
}

get {
  url: https://{{subdomain}}.cyberark.cloud/api/connector-pools/:poolID
  body: none
  auth: bearer
}

params:path {
  poolID: poolID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
