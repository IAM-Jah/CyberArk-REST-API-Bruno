meta {
  name: List Secrets
  type: http
  seq: 1
}

get {
  url: https://{{subdomain}}.secretshub.cyberark.cloud/api/secrets?projection=EXTEND
  body: none
  auth: bearer
}

params:query {
  projection: EXTEND
  ~limit: 100
  ~offset: 50
}

headers {
  Content-Type: application/json
  Accept: application/x.secretshub.beta+json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "scope": {
      "secretStoresIds": [
        "store-c3051c3a-5584-43e3-905d-420b37d5633c"
      ]
    }
  }
}
