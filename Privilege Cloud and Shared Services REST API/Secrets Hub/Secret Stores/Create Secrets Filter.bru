meta {
  name: Create Secrets Filter
  type: http
  seq: 2
}

post {
  url: https://{{subdomain}}.secretshub.cyberark.cloud/api/secret-stores/:storeID/filters
  body: json
  auth: bearer
}

params:path {
  storeID: storeID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "data": {
      "safeName": "MySafe"
    },
    "type": "PAM_SAFE"
  }
}
