meta {
  name: Get a Secret Store
  type: http
  seq: 5
}

get {
  url: https://{{subdomain}}.secretshub.cyberark.cloud/api/secret-stores/:storeID
  body: none
  auth: bearer
}

params:path {
  storeID: storeID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
