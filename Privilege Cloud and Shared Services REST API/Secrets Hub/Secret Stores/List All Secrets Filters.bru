meta {
  name: List All Secrets Filters
  type: http
  seq: 1
}

get {
  url: https://{{subdomain}}.secretshub.cyberark.cloud/api/secret-stores/:storeID/filters
  body: none
  auth: bearer
}

params:path {
  storeID: storeID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
