meta {
  name: Delete Secrets Filter
  type: http
  seq: 4
}

delete {
  url: https://{{subdomain}}.secretshub.cyberark.cloud/api/secret-stores/:storeID/filters/:filterID
  body: none
  auth: bearer
}

params:path {
  filterID: filterID
  storeID: storeID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
