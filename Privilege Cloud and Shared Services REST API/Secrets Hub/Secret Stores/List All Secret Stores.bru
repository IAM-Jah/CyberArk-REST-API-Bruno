meta {
  name: List All Secret Stores
  type: http
  seq: 8
}

get {
  url: https://{{subdomain}}.secretshub.cyberark.cloud/api/secret-stores?behavior=SECRETS_TARGET&filter=stringQuery
  body: none
  auth: bearer
}

