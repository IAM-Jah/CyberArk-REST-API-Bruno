meta {
  name: Get Secret Store Connection Status
  type: http
  seq: 10
}

get {
  url: https://{{subdomain}}.secretshub.cyberark.cloud/api/secret-stores/:storeID/status/connection
  body: none
  auth: bearer
}

params:path {
  storeID: storeID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
