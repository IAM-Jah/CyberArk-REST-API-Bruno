meta {
  name: Update Secret Store
  type: http
  seq: 7
}

patch {
  url: https://{{subdomain}}.secretshub.cyberark.cloud/api/secret-stores/:storeID
  body: json
  auth: bearer
}

params:path {
  storeID: storeID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "data": {
      "accountAlias": "Account alias as defined in AWS",
      "roleName": "Secrets-Hub-IAM-Role-Name-Created-For-Secrets-Hub"
    },
    "description": "AWS Secrets Manager for dev-team-prod",
    "name": "Account alias - us-east-1"
  }
}
