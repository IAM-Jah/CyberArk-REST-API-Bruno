meta {
  name: Create Policy V2
  type: http
  seq: 3
}

post {
  url: https://{{subdomain}}.sca.cyberark.cloud/api/policies/create-policy
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{SCAToken}}
}

body:json {
