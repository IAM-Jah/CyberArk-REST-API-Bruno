meta {
  name: Get Pending Self Service Invitation Requests
  type: http
  seq: 3
}

get {
  url: https://api.alero.io/v2-edge/selfServiceRequests/
  body: none
  auth: bearer
}

params:query {
  ~searchString: string
  ~searchIn: string
  ~fromTime: int64
  ~toTime: int64
  ~offset: integer
  ~limit: integer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{remoteAccessToken}}
}
