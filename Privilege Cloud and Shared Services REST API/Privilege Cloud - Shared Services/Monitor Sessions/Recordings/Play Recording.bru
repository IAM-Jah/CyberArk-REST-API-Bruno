meta {
  name: Play Recording
  type: http
  seq: 5
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/recordings/:recordingID/Play/
  body: none
  auth: bearer
}

params:path {
  recordingID: {{recordingID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
