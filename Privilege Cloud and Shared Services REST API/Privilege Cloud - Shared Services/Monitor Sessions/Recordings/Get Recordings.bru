meta {
  name: Get Recordings
  type: http
  seq: 1
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/recordings/:recordingID/
  body: none
  auth: bearer
}

params:query {
  ~Limit: 25
  ~Sort: string
  ~Offset: 0
  ~Search: {{searchTerms}}
  ~Safe: {{safeName}}
  ~FromTime: integer
  ~ToTime: integer
  ~Activities: string
}

params:path {
  recordingID: {{recordingID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
