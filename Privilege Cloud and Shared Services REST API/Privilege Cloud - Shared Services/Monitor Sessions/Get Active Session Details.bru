meta {
  name: Get Active Session Details
  type: http
  seq: 2
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/livesessions/:activeSessionId/
  body: none
  auth: bearer
}

params:path {
  activeSessionId: {{activeSessionId}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
