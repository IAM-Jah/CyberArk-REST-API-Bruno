meta {
  name: Suspend or Resume an Active Session
  type: http
  seq: 2
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/LiveSessions/:activeSessionId/:action/
  body: none
  auth: bearer
}

params:path {
  action: suspend/resume
  activeSessionId: {{activeSessionId}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
