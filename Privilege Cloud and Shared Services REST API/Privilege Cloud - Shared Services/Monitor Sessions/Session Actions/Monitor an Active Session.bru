meta {
  name: Monitor an Active Session
  type: http
  seq: 1
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/LiveSessions/:activeSessionID/Monitor/
  body: none
  auth: bearer
}

params:path {
  activeSessionID: {{activeSessionId}}
}

headers {
  Content-Type: application/json
  Accept: RDP/PSMGW
}

auth:bearer {
  token: {{identityToken}}
}
