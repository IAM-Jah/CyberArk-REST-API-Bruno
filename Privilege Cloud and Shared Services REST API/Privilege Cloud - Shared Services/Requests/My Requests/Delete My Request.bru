meta {
  name: Delete My Request
  type: http
  seq: 4
}

delete {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/passwordvault/api/myrequests/:requestID
  body: none
  auth: bearer
}

params:path {
  requestID: {{requestID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
