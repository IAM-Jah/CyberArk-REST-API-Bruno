meta {
  name: Delete an MFA Caching SSH Key
  type: http
  seq: 3
}

delete {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/Users/Secret/SSHKeys/Cache/
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
