meta {
  name: Delete All MFA Caching SSH Keys
  type: http
  seq: 5
}

delete {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/Users/Secret/SSHKeys/ClearCache/
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
