meta {
  name: Get Session Management Policy of Platform
  type: http
  seq: 3
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/Platforms/Targets/:platformID/PrivilegedSessionManagement/
  body: none
  auth: bearer
}

params:path {
  platformID: {{platformID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
