meta {
  name: Get All Safes
  type: http
  seq: 1
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/Safes/
  body: none
  auth: bearer
}

params:query {
  ~search: {{searchTerms}}
  ~offset: 0
  ~limit: 25
  ~sort: safeName asc/desc
  ~includeAccounts: false
  ~extendedDetails: true
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
