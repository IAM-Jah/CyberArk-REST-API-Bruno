meta {
  name: Delete Safe Member
  type: http
  seq: 5
}

delete {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/Safes/:safeID/Members/:safeMemberName/
  body: none
  auth: bearer
}

params:path {
  safeMemberName: {{safeMemberName}}
  safeID: {{safeID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
