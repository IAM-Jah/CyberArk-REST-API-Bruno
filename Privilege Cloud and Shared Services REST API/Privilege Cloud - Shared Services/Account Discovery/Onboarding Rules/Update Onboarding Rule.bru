meta {
  name: Update Onboarding Rule
  type: http
  seq: 3
}

put {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/AutomaticOnboardingRules/:ruleID/
  body: json
  auth: bearer
}

params:path {
  ruleID: {{ruleID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "TargetPlatformId": "{{platformID}}",
    "TargetSafeName": "{{safeName}}",
    "IsAdminIDFilter": false,
    "MachineTypeFilter": "AnyOrWorkstationOrServer",
    "SystemTypeFilter": "WindowsOrUnix",
    "UserNameFilter": "userName",
    "UserNameMethod": "EqualsOrBeginsOrEnds",
    "AddressFilter": "IPOrDNSDomainName",
    "AddressMethod": "EqualsOrBeginsOrEnds",
    "AccountCategoryFilter": "AnyOrPrivilegedOrNon-privileged",
    "RuleName": "ruleName",
    "RuleDescription": "description"
  }
}
