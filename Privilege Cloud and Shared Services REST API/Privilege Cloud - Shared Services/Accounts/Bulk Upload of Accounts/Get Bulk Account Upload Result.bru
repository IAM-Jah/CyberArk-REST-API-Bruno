meta {
  name: Get Bulk Account Upload Result
  type: http
  seq: 2
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/bulkactions/accounts/:bulkUploadID/
  body: none
  auth: bearer
}

params:path {
  bulkUploadID: {{bulkUploadID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
