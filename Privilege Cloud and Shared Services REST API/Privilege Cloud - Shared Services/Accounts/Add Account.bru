meta {
  name: Add Account
  type: http
  seq: 5
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/Accounts/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "name": "accountName",
    "address": "accountAddress",
    "userName": "accountUsername",
    "platformId": "{{platformID}}",
    "safeName": "{{safeName}}",
    "secretType": "password/private SSH key",
    "secret": "secretValue-WillNotBeReturnedInResult",
    "platformAccountProperties": {
      "LogonDomain": "string",
      "Port": "number"//,
      //"CustomFileCategory": "value"
    },
    "secretManagement": {
      "automaticManagementEnabled": true,
      "manualManagementReason": "string"//,
      //"status": "inProcess, succeeded, failed, partiallySucceeded",
      //"lastModifiedDateTime": "stringWithDate-Time",
      //"lastReconciledDateTime": "stringWithDate-Time",
      //"lastVerifiedDateTime": "stringWithDate-Time"
    },
    "remoteMachinesAccess": {
      "remoteMachines": "server1.domain.com;server2.domain.com",
      "accessRestrictedToRemoteMachines": true
    }
  }
}
