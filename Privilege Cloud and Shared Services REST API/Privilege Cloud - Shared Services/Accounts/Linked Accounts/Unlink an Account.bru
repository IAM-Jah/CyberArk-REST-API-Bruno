meta {
  name: Unlink an Account
  type: http
  seq: 2
}

delete {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/Accounts/:accountID/LinkAccount/:extraPassIndex/
  body: none
  auth: bearer
}

params:path {
  extraPassIndex: {{extraPassIndex}}
  accountID: {{accountID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
