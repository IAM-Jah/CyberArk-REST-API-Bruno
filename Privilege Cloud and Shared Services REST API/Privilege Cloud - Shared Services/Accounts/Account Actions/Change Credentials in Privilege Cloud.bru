meta {
  name: Change Credentials in Privilege Cloud
  type: http
  seq: 3
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/Accounts/{{accountID}}/Password/Update/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "ChangeEntireGroup": false,
    "NewCredentials": "newPassword"
    //No digits as first or last character regardless of policy
    //Leading and trailing whitespaces are automatically removed
  }
}
