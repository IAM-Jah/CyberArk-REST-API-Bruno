meta {
  name: Change Password- Set Next Password
  type: http
  seq: 4
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/Accounts/:accountID/SetNextPassword/
  body: json
  auth: bearer
}

params:path {
  accountID: {{accountID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "ChangeImmediately" : true,
    "NewCredentials": "newPassword"
  }
}
