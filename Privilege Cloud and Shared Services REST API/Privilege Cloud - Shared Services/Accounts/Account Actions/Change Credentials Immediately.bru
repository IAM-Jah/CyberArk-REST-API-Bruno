meta {
  name: Change Credentials Immediately
  type: http
  seq: 2
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/Accounts/:accountID/Change/
  body: json
  auth: bearer
}

params:path {
  accountID: {{accountID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "ChangeEntireGroup" : true
  }
}
