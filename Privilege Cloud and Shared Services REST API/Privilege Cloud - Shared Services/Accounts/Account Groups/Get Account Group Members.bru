meta {
  name: Get Account Group Members
  type: http
  seq: 2
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/AccountGroups/:groupID/Members/
  body: none
  auth: bearer
}

params:path {
  groupID: {{groupID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
