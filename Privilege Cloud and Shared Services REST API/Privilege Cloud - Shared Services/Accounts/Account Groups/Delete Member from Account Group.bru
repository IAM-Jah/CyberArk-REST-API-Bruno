meta {
  name: Delete Member from Account Group
  type: http
  seq: 5
}

delete {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/AccountGroups/:groupID/Members/:accountID/
  body: none
  auth: bearer
}

params:path {
  accountID: {{accountID}}
  groupID: {{groupID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
