meta {
  name: Update Dependent Account
  type: http
  seq: 4
}

put {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/api/accounts/:accountID/account-dependents/:dependentAccountID
  body: json
  auth: bearer
}

params:path {
  accountID: {{accountID}}
  dependentAccountID: {{dependentAccountID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "name": "string",
    "platformDependentProperties": {},
    "secretManagement": {
      "automaticManagementEnabled": true,
      "manualManagementReason": "string",
      "disableParentAutomaticManagement": false
    },
    "platformId": "string",
    "additionalProp1": {}
  }
}

docs {
  https://docs.cyberark.com/privilege-cloud-shared-services/latest/en/content/privilegecloudapis/account-dependents-cpm.htm
}
