meta {
  name: Add Application Authentication Method
  type: http
  seq: 5
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/WebServices/PIMServices.svc/Applications/:appID/Authentications
  body: json
  auth: bearer
}

params:path {
  appID: {{appID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "authentication":
    {
      "AuthType":"path",
      "AuthValue":"pathString",
      "IsFolder":true,
      "AllowInternalScripts":true
    }
  }
