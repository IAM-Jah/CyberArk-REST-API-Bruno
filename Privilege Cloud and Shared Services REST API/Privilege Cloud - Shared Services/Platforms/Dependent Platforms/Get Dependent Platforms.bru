meta {
  name: Get Dependent Platforms
  type: http
  seq: 1
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/platforms/dependents/
  body: none
  auth: bearer
}

params:query {
  ~search: {{searchTerms}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
