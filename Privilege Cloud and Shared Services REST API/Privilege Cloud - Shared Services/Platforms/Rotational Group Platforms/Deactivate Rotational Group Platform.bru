meta {
  name: Deactivate Rotational Group Platform
  type: http
  seq: 3
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/platforms/rotationalGroups/:groupID/deactivate/
  body: none
  auth: bearer
}

params:path {
  groupID: {{groupID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
