meta {
  name: Activate Target Platform
  type: http
  seq: 2
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/platforms/targets/:platformID/activate/
  body: none
  auth: bearer
}

params:path {
  platformID: {{platformID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
