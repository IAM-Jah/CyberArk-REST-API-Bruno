meta {
  name: Duplicate Target Platforms
  type: http
  seq: 4
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/platforms/targets/:platformID/duplicate/
  body: json
  auth: bearer
}

params:path {
  platformID: {{platformID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
      "Name": "{{platformName}}",
      "Description": "platformDescription"
  }
}
