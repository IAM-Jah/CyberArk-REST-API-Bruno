meta {
  name: Get Target Platforms
  type: http
  seq: 1
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/PasswordVault/API/platforms/targets/?search={{searchTerms}}
  body: none
  auth: bearer
}

params:query {
  search: {{searchTerms}}
  ~filter: active eq True AND systemType eq Databases
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
