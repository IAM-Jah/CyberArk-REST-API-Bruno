meta {
  name: Get Discovered Account
  type: http
  seq: 2
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.cloud/api/discovered-accounts/:accountID
  body: none
  auth: bearer
}

params:query {
  ~extendedDetails: true
}

params:path {
  accountID: {{accountID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
