meta {
  name: Deletes an Existing Strong Account
  type: http
  seq: 2
}

delete {
  url: https://{{subdomain}}-jit.cyberark.cloud/api/secrets/public/v1/:strongAcctID
  body: none
  auth: bearer
}

params:path {
  strongAcctID: {{strongAccountID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
