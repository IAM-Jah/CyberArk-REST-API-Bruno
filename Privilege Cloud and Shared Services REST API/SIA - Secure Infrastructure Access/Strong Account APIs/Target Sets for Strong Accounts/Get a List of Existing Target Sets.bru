meta {
  name: Get a List of Existing Target Sets
  type: http
  seq: 1
}

get {
  url: https://{{subdomain}}-jit.cyberark.cloud/api/discovery/targetsets
  body: none
  auth: bearer
}

params:query {
  ~b64StartKey: string
  ~name: targetSetName
  ~strongAccountID: string
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
