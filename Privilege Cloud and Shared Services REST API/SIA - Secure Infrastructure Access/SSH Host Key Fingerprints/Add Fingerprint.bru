meta {
  name: Add Fingerprint
  type: http
  seq: 4
}

post {
  url: https://{{subdomain}}-jit.cyberark.cloud/api/ssh-fingerprints
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "target_id": "string",
    "fingerprint": "string"
  }
}
