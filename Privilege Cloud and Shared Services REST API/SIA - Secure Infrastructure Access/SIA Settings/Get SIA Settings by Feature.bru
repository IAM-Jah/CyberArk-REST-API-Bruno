meta {
  name: Get SIA Settings by Feature
  type: http
  seq: 1
}

get {
  url: https://{{subdomain}}-jit.cyberark.cloud/api/settings/:dpaFeatureName
  body: none
  auth: bearer
}

params:path {
  dpaFeatureName: mfaCaching
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
