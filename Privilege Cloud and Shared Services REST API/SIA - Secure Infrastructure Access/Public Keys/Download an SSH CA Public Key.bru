meta {
  name: Download an SSH CA Public Key
  type: http
  seq: 1
}

get {
  url: https://{{subdomain}}-jit.cyberark.cloud/api/public-keys?workspaceId=wiorkspaceIDToApplyKey&workspaceType=AWS/AZURE/ON-PREMISE/GCP
  body: none
  auth: bearer
}

params:query {
  workspaceId: wiorkspaceIDToApplyKey
  workspaceType: AWS/AZURE/ON-PREMISE/GCP
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
