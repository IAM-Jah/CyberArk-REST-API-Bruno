meta {
  name: Get a Specific Policy by ID
  type: http
  seq: 1
}

get {
  url: https://{{subdomain}}-jit.cyberark.cloud/api/access-policies/:DPAPolicyID
  body: none
  auth: bearer
}

params:path {
  DPAPolicyID: {{DPAPolicyID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
