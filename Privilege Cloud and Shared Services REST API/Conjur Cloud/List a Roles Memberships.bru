meta {
  name: List a Roles Memberships
  type: http
  seq: 13
}

get {
  url: https://{{subdomain}}.secretsmgr.cyberark.cloud/api/roles/conjur/:roleType/:identifier?memberships
  body: none
  auth: bearer
}

params:query {
  memberships: 
}

params:path {
  identifier: data%2Fmyapp-01
  roleType: User|Host|Layer|Group|Policy
}

auth:bearer {
  token: token="{{conjurToken}}"
}

body:form-urlencoded {
  enabled: true
}
