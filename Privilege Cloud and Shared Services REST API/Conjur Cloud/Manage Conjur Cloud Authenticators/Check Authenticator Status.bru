meta {
  name: Check Authenticator Status
  type: http
  seq: 2
}

get {
  url: https://{{subdomain}}.secretsmgr.cyberark.cloud/api/:authenticatorType/:serviceID/conjur/status
  body: none
  auth: bearer
}

params:path {
  authenticatorType: authenticatorType
  serviceID: serviceID
}

auth:bearer {
  token: token="{{conjurToken}}"
}

body:form-urlencoded {
  enabled: true
}
