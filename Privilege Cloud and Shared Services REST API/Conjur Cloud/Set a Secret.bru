meta {
  name: Set a Secret
  type: http
  seq: 5
}

post {
  url: https://{{subdomain}}.secretsmgr.cyberark.cloud/api/secrets/conjur/variable/:variableID
  body: text
  auth: bearer
}

params:path {
  variableID: data%2Fmyapp-01
}

auth:bearer {
  token: token="{{conjurToken}}"
}

body:text {
  secretdatainbinary
}

body:form-urlencoded {
  enabled: true
}
