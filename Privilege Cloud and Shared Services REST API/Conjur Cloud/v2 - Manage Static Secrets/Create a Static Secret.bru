meta {
  name: Create a Static Secret
  type: http
  seq: 1
}

post {
  url: https://{{subdomain}}.secretsmgr.cyberark.cloud/api/secrets/static
  body: json
  auth: bearer
}

headers {
  Accept: application/x.secretsmgr.v2+json
  Content-Type: application/json
}

auth:bearer {
  token: token="{{conjurToken}}"
}

body:json {
  {
    "branch": "data/dynamic/*, data/vault/*",
    "name": "secretName",
    "mime_type": "application/octet-stream",
    "value": "secretValue",
    "annotations": [
      {
        "name": "description",
        "value": "secret to store password for my-app"
      }
      ],
      "permissions": [
      {
        "subject": {
          "id": "data/admins-group1",
          "kind": "group"
        },
        "privileges": [
          "read"
        ]
      }
    ]
  }
}

body:form-urlencoded {
  id: data/aws-apps/my-aws-workload
  kind: user|host|group
}
