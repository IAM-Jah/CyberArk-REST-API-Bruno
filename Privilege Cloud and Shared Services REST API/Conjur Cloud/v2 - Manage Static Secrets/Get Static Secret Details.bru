meta {
  name: Get Static Secret Details
  type: http
  seq: 2
}

get {
  url: https://{{subdomain}}.secretsmgr.cyberark.cloud/api/secrets/static/:branch/:secretName
  body: none
  auth: bearer
}

params:path {
  secretName: secretName
  branch: data/branch
}

headers {
  Accept: application/x.secretsmgr.v2+json
}

auth:bearer {
  token: token="{{conjurToken}}"
}

body:form-urlencoded {
  id: data/aws-apps/my-aws-workload
  kind: user|host|group
}
