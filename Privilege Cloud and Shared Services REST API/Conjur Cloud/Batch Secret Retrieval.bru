meta {
  name: Batch Secret Retrieval
  type: http
  seq: 7
}

get {
  url: https://{{subdomain}}.secretsmgr.cyberark.cloud/api/secrets?variable_ids=conjur:variable:secret1,conjur:variable:secret2
  body: none
  auth: bearer
}

params:query {
  variable_ids: conjur:variable:secret1,conjur:variable:secret2
}

auth:bearer {
  token: token="{{conjurToken}}"
}

body:form-urlencoded {
  enabled: true
}
