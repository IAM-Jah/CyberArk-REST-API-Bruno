meta {
  name: Retrieve a Secret
  type: http
  seq: 6
}

get {
  url: https://{{subdomain}}.secretsmgr.cyberark.cloud/api/secrets/conjur/variable/:variableID
  body: none
  auth: bearer
}

params:query {
  ~version: 1-20
}

params:path {
  variableID: data%2Fmyapp-01
}

auth:bearer {
  token: token="{{conjurToken}}"
}

body:form-urlencoded {
  enabled: true
}
