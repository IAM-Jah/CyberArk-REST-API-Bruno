meta {
  name: Generate Password
  type: http
  seq: 1
}

post {
  url: https://{{identityTenantID}}.id.cyberark.cloud/Core/GeneratePassword?passwordLength=string
  body: none
  auth: bearer
}

params:query {
  passwordLength: string
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
