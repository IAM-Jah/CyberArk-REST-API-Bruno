meta {
  name: Change User Password
  type: http
  seq: 2
}

post {
  url: https://{{identityTenantID}}.id.cyberark.cloud/UserMgmt/ChangeUserPassword
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "oldPassword": "OldSamplepassword123",
    "newPassword": "NewSamplepassword123"
  }
}
