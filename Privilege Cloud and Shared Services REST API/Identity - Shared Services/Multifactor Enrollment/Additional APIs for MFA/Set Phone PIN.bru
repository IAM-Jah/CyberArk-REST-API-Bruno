meta {
  name: Set Phone PIN
  type: http
  seq: 2
}

post {
  url: https://{{identityTenantID}}.id.cyberark.cloud/Security/GetQRCodeStatus
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "ID": "string",
    "phonepin": "string"
  }
}
