meta {
  name: Get Risk Level for a Specified User
  type: http
  seq: 1
}

post {
  url: https://{{identityTenantID}}.id.cyberark.cloud/UserMgmt/GetUserRiskLevel
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "ID": "userUUID"
  }
}
