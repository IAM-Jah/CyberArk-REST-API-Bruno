meta {
  name: Update AD User Attributes
  type: http
  seq: 8
}

post {
  url: https://{{identityTenantID}}.id.cyberark.cloud/UserMgmt/ChangeUserAttributes
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
