meta {
  name: Disable or Enable a User
  type: http
  seq: 2
}

post {
  url: https://{{identityTenantID}}.id.cyberark.cloud/UserMgmt/SetCloudLock?user=userUUID&lockUser=true
  body: none
  auth: bearer
}

params:query {
  user: userUUID
  lockUser: true
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
