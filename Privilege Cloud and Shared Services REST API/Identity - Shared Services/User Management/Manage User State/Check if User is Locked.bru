meta {
  name: Check if User is Locked
  type: http
  seq: 4
}

post {
  url: https://{{identityTenantID}}.id.cyberark.cloud/UserMgmt/IsUserLockedOutByPolicy?user=userUUID
  body: none
  auth: bearer
}

params:query {
  user: userUUID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
