meta {
  name: Set users picture
  type: http
  seq: 2
}

post {
  url: https://{{identityTenantID}}.id.cyberark.cloud/CDirectoryService/SetUserPicture?ID=userUUID
  body: multipartForm
  auth: bearer
}

params:query {
  ID: userUUID
}

headers {
  Content-Type: multipart/form-data
}

auth:bearer {
  token: {{identityToken}}
}

body:multipart-form {
  Picture: @file()
}
