meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: https://{{identityTenantID}}.id.cyberark.cloud/CDirectoryService/CreateUser
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

