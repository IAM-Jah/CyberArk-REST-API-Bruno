meta {
  name: Update Group
  type: http
  seq: 4
}

put {
  url: https://{{identityTenantID}}.id.cyberark.cloud/scim/Groups/:groupID
  body: json
  auth: bearer
}

params:path {
  groupID: ID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "displayName": "string",
    "members": [
      {}
    ],
    "schemas": [
      "string"
    ]
  }
}
