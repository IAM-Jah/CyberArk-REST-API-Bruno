meta {
  name: Get Privileged Data by ID
  type: http
  seq: 3
}

get {
  url: https://{{identityTenantID}}.id.cyberark.cloud/scim/PrivilegedData/:accountID
  body: none
  auth: bearer
}

params:path {
  accountID: ID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}
