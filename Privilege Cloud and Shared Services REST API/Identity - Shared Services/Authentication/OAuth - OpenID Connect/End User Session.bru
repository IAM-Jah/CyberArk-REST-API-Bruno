meta {
  name: End User Session
  type: http
  seq: 11
}

post {
  url: https://{{identityTenantID}}.id.cyberark.cloud/OAuth2/EndSession/:clientAppID
  body: none
  auth: bearer
}

params:query {
  ~id_token_hint: string
  ~post_logout_redirect_uri: string
  ~state: string
}

params:path {
  clientAppID: {{cientAppID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:form-urlencoded {
  grant_type: client_credentials
  scope: AllAPIsScope
}
