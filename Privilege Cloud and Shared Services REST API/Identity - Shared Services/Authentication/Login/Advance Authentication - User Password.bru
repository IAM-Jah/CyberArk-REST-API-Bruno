meta {
  name: Advance Authentication - User Password
  type: http
  seq: 5
}

post {
  url: https://{{identityTenantID}}.id.cyberark.cloud/Security/AdvanceAuthentication
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "SessionId": "{{identitySessionID}}",
      "MechanismId": "{{identityMechanismID}}",
      "Action": "Answer",
      "Answer": "{{identityPassword}}",
      "PersistentLogin": "true"
  }
}

assert {
  res.status: eq 200
}

tests {
  const jsonData = res.getBody().Result
  
  // Check if 'Token' exists, indicating that password was the only MFA requirement.
  test("Check for token", function() {
    // If 'Token' doesn't exist, present an error message indicating the user should continue with authentication.
    expect(
      jsonData,
      "Identity Token does not exist: continue with Advance Authentication API(s) to complete authentication process using mechanism 2"
    ).to.have.property("Token");
      // If 'Token' exists, store it as 'IdentityToken' environment variable.
      bru.setEnvVar("identityToken", jsonData.Token);
  });
}
