meta {
  name: Set User Credentials for an Application
  type: http
  seq: 19
}

post {
  url: https://{{identityTenantID}}.id.cyberark.cloud/UPRest/SetUserCredsForApp
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "Password": "string",
    "PublicKeyHash": "string",
    "appkey": "string",
    "Username": "string",
    "ConnectorId": "string"
  }
}
