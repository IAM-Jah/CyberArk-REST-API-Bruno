meta {
  name: Update Secured Item Credentials
  type: http
  seq: 21
}

post {
  url: https://{{identityTenantID}}.id.cyberark.cloud/UPRest/UpdateCredsForSecuredItem
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "Password": "string",
    "CustomFields": "string",
    "Notes": "string",
    "Username": "string"
  }
}
