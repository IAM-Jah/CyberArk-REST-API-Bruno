  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "Version": "string",
    "Os": "string",
    "SimpleName": "string",
    "Udid": "string",
    "Imei": "string",
    "Manufacturer": "string",
    "Name": "string"
  }
}
