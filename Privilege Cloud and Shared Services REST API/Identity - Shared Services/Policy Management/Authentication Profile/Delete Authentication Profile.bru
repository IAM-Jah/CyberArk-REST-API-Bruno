meta {
  name: Delete Authentication Profile
  type: http
  seq: 1
}

post {
  url: https://{{identityTenantID}}.id.cyberark.cloud/AuthProfile/DeleteProfile?uuid=authProfileUUID
  body: json
  auth: bearer
}

params:query {
  uuid: authProfileUUID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "uuid": "string"
  }
}
