meta {
  name: Signup External Users
  type: http
  seq: 1
}

post {
  url: https://{{identityTenantID}}.id.cyberark.cloud/User/Signup
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{identityToken}}
}

body:json {
  {
    "Password": "string",
    "HomeNumber": "string",
    "PrimaryIdentifier": "string",
    "DisplayName": "string",
    "OfficeNumber": "string",
    "MobileNumber": "string",
    "VerifyEmail": true,
    "Mail": "string",
    "ReCaptchaToken": "string",
    "Description": "string",
    "Name": "string"
  }
}
