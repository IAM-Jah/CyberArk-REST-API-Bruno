meta {
  name: Update Group
  type: http
  seq: 4
}

put {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/UserGroups/:groupID
  body: json
  auth: none
}

params:path {
  groupID: {{groupID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}

body:json {
  {
      "groupName": "UnixAdmins"
  }
}
