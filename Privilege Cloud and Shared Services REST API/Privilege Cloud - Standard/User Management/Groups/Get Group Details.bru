meta {
  name: Get Group Details
  type: http
  seq: 2
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/UserGroups/:groupID/
  body: none
  auth: none
}

params:query {
  ~includeMembers: false
}

params:path {
  groupID: {{groupID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}
