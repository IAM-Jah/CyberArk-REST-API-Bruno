meta {
  name: Update User
  type: http
  seq: 4
}

put {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/Users/:userID/
  body: json
  auth: none
}

params:path {
  userID: {{userID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}

body:json {
