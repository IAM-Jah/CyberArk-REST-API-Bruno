meta {
  name: Get User Details
  type: http
  seq: 2
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/Users/:userID/
  body: none
  auth: none
}

params:path {
  userID: {{userID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}
