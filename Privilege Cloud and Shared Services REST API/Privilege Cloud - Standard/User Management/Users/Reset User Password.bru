meta {
  name: Reset User Password
  type: http
  seq: 9
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/Users/:userID/ResetPassword
  body: json
  auth: none
}

params:path {
  userID: {{userID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}

body:json {
  {
    "id": "{{userID}}",
    "newPassword": "{{PAMNewPassword}}"
  }
}
