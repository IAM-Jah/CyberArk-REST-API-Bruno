meta {
  name: Generate an MFA Caching SSH Key
  type: http
  seq: 1
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/Users/Secret/SSHKeys/Cache/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}

body:json {
  {
    "formats":"{{MFAKeyFormat}}",
    "keyPassword":"passphraseOrRemoveThisParameter"
  }
}
