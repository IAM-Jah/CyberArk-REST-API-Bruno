meta {
  name: Duplicate Group Platforms
  type: http
  seq: 2
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/platforms/groups/:platformID/duplicate/
  body: json
  auth: none
}

params:path {
  platformID: {{platformID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}

body:json {
  {
      "Name": "test Platform",
      "Description": ""
  }
}
