meta {
  name: Import Platform
  type: http
  seq: 3
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/Platforms/Import/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}

body:json {
  {
    "ImportFile": {zip file byte array}
  }
}
