meta {
  name: Get Directory Mapping List
  type: http
  seq: 1
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/Configuration/LDAP/Directories/:domainURL/Mappings/
  body: none
  auth: none
}

params:path {
  domainURL: {{domainURL}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}
