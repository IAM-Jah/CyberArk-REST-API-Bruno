meta {
  name: Delete Safe
  type: http
  seq: 3
}

delete {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/Safes/:safeId/
  body: json
  auth: none
}

params:path {
  safeId: {{safeID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}
