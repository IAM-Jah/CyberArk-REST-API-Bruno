meta {
  name: Delete Application Authentication Method
  type: http
  seq: 7
}

delete {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/WebServices/PIMServices.svc/Applications/:appID/Authentications/:appAuthMethodID
  body: none
  auth: none
}

params:path {
  appAuthMethodID: {{appAuthMethodID}}
  appID: {{appID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}
