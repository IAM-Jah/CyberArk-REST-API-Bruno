meta {
  name: Get Recording Activities
  type: http
  seq: 4
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/recordings/:recordingID/activities/
  body: none
  auth: none
}

params:path {
  recordingID: {{recordingID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}
