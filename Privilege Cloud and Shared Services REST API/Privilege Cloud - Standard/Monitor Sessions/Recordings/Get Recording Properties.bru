meta {
  name: Get Recording Properties
  type: http
  seq: 3
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/recordings/:recordingID/properties/
  body: none
  auth: none
}

params:path {
  recordingID: {{recordingID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}
