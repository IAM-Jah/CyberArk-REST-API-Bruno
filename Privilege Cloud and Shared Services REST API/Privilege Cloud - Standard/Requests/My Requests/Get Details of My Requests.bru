meta {
  name: Get Details of My Requests
  type: http
  seq: 3
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/myrequests/:requestID
  body: none
  auth: none
}

params:path {
  requestID: {{requestID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}
