meta {
  name: Import Custom Ticketing System
  type: http
  seq: 1
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/ticketing-systems/import
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}

body:json {
  {
    "ticketingZipFile": "zipFileContainingDLLAndXMLFiles"
  }
}
