meta {
  name: Change Credentials- Set Next Password
  type: http
  seq: 9
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/Accounts/:accountID/SetNextPassword/
  body: json
  auth: none
}

params:path {
  accountID: {{accountID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}

body:json {
  {
    "ChangeImmediately" : true,
    "NewCredentials": "newPassword"
  }
}
