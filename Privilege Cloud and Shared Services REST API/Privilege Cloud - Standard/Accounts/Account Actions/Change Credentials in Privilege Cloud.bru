meta {
  name: Change Credentials in Privilege Cloud
  type: http
  seq: 10
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/Accounts/:accountID/Password/Update/
  body: json
  auth: none
}

params:path {
  accountID: {{accountID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}

body:json {
  {
    "ChangeEntireGroup": false,
    "NewCredentials": "newPassword"
    //No digits as first or last character regardless of policy
    //Leading and trailing whitespaces are automatically removed
  }
}
