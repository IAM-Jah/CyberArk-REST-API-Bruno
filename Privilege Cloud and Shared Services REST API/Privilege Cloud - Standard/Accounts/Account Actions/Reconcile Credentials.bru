meta {
  name: Reconcile Credentials
  type: http
  seq: 11
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/Accounts/:accountID/Reconcile/
  body: none
  auth: none
}

params:path {
  accountID: {{accountID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}
