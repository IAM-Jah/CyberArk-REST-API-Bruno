meta {
  name: Get Password Value
  type: http
  seq: 3
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/Accounts/:accountID/Password/Retrieve/
  body: json
  auth: none
}

params:path {
  accountID: {{accountID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}

body:json {
  {
      "reason": "Retrieved through Bruno",
      "TicketingSystem": "{{ticketingSystemName}}",
      "TicketId": "{{ticketID}}",
      //"Version": <version number>,
      "ActionType": "<showOrCopyOrConnect>",
      //"isUse": false,
      "Machine": "targetAddress"
  }
}
