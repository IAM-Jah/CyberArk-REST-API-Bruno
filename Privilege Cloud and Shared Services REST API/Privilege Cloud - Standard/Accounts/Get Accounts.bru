meta {
  name: Get Accounts
  type: http
  seq: 1
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/Accounts
  body: none
  auth: none
}

params:query {
  ~search: list of keywords separated by spaces
  ~searchType: contains/startswith
  ~sort: asc/desc
  ~offset: 0
  ~limit: 50
  ~filter: safename eq mySafe AND ModificationTime gte 0
  ~savedfilter: Regular/Recently/New/Deleted/etc.
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}
