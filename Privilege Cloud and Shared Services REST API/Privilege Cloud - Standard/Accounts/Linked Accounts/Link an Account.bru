meta {
  name: Link an Account
  type: http
  seq: 1
}

post {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/Accounts/:accountID/LinkAccount/
  body: json
  auth: none
}

params:path {
  accountID: {{accountID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}

body:json {
  {
      "Name": "objectName",
      "ExtraPassID": "1/2/3"
  }
}
