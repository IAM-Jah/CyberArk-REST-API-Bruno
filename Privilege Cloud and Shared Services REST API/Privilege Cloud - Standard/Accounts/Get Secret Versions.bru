meta {
  name: Get Secret Versions
  type: http
  seq: 4
}

get {
  url: https://{{subdomain}}.privilegecloud.cyberark.com/PasswordVault/API/Accounts/:accountID/Secret/Versions/
  body: none
  auth: none
}

params:query {
  ~showTemporary: true
}

params:path {
  accountID: {{accountID}}
}

headers {
  Content-Type: application/json
  Authorization: {{PAMSessionToken}}
}
