meta {
  name: Get Computer Groups
  type: http
  seq: 15
}

get {
  url: https://{{EPMAddress}}/EPM/API/:version/Sets/:setID/ComputerGroups
  body: none
  auth: none
}

params:query {
  ~$filter: contains(Name,'MyGroup')
}

params:path {
  setID: setID
  version: version
}

headers {
  Content-Type: application/json
  Authorization: basic {{EPMToken}}
  VFUser: {{EPMToken}}
}
