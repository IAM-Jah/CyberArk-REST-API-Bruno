meta {
  name: Update JIT Access and Elevation Policy
  type: http
  seq: 13
}

patch {
  url: https://{{EPMAddress}}/EPM/API/:version/Sets/:setID/Policies/:policyID
  body: json
  auth: none
}

params:path {
  policyID: policyID
  setID: setID
  version: version
}

headers {
  Content-Type: application/json
  Authorization: basic {{EPMToken}}
  ~VFUser: {{EPMToken}}
}

