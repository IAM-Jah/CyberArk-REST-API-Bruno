meta {
  name: Get Policies
  type: http
  seq: 10
}

get {
  url: https://{{EPMAddress}}/EPM/API/:version/Sets/:setID/Policies
  body: none
  auth: none
}

params:query {
  ~Offset: Number
  ~Limit: Number
  ~PolicyType: String
}

params:path {
  setID: setID
  version: version
}

headers {
  Content-Type: application/json
  Authorization: basic {{EPMToken}}
  ~VFUser: {{EPMToken}}
}
