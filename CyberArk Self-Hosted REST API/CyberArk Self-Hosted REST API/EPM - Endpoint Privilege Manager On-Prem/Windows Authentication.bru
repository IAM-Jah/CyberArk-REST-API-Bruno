meta {
  name: Windows Authentication
  type: http
  seq: 2
}

post {
  url: https://{{EPMAddress}}/EPM/API/:version/Auth/Windows/Logon
  body: json
  auth: none
}

params:path {
  version: version
}

headers {
  Content-Type: application/json
}

body:json {
  {
  "ApplicationID": "string"
  }
}

tests {
  const jsonData = res.getBody().Result
  
  test("EPM Token Exists", function() {
      expect(jsonData).to.have.property('EPMAuthenticationResult');
      bru.setEnvVar("EPMToken", jsonData.EPMAuthenticationResult);
  });
}
