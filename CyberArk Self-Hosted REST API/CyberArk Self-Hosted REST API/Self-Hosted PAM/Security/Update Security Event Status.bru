meta {
  name: Update Security Event Status
  type: http
  seq: 2
}

patch {
  url: https://{{PVWAAddress}}/PasswordVault/API/pta/API/Events/:eventID
  body: json
  auth: bearer
}

params:path {
  eventID: eventID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PTASessionToken}}
}

body:json {
  {
  "mStatus": "CLOSED",
  "closeReason": "HANDLED",
  "reasonText": "Handled by SOC team"
  }
}
