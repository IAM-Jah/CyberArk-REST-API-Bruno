meta {
  name: Update Session Management Policy of Platform
  type: http
  seq: 5
}

put {
  url: https://{{PVWAAddress}}/PasswordVault/API/Platforms/Targets/:platformID/PrivilegedSessionManagement/
  body: json
  auth: bearer
}

params:path {
  platformID: {{platformID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

body:json {
  {
      "PSMServerId":"PSMServer_e7b11b1",
      "PSMServerName":"PSMServer2",
      "PSMConnectors": [
          {
              "PSMConnectorID": "PSM-AWSConsoleWithSTS",
              "Enabled": false
          },
          {
              "PSMConnectorID": "SSH",
              "Enabled": true
          }
      ]
  }
}
