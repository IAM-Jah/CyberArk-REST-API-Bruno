meta {
  name: Import Connection Component
  type: http
  seq: 1
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/ConnectionComponents/Import/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

body:json {
  {
      "ImportFile": {zip file byte array}
  }
}
