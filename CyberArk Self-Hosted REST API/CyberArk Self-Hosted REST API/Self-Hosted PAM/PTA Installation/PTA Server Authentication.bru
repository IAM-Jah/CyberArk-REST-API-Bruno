meta {
  name: PTA Server Authentication
  type: http
  seq: 2
}

post {
  url: https://{{PTAAddress}}/installer/api/getauthtoken
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  username: {{PTAUsername}}
  password: {{PTAPassword}}
}

tests {
  const jsonData = res.getBody().Result
  
  test("PTA token Exists", function() {
      if (jsonData.Token) {
          bru.setEnvVar("PTASessionToken", jsonData.Token);
      }
  });
}
