meta {
  name: Get Mapping Details
  type: http
  seq: 2
}

get {
  url: https://{{PVWAAddress}}/PasswordVault/API/Configuration/LDAP/Directories/:LDAPID/Mappings/:directoryUID/
  body: none
  auth: bearer
}

params:path {
  directoryUID: mappingID
  LDAPID: directoryID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
