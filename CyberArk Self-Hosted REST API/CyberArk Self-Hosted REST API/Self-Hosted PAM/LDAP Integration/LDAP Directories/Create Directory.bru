meta {
  name: Create Directory
  type: http
  seq: 3
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/Configuration/LDAP/Directories/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

body:json {
  {
  "DirectoryType": "string",
  "DCList ": [{
       "Name":"string", "Port":"int", "SSLConnect":"bool"}
  ],
  "BindUsername": "string",
  "BindPassword": "string",
  "Port": 0,
  "DomainName": "string",
  "DomainBaseContext": "string"
  }
}
