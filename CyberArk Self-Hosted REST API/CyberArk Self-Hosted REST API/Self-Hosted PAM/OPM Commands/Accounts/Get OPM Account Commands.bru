meta {
  name: Get OPM Account Commands
  type: http
  seq: 1
}

get {
  url: https://{{PVWAAddress}}/PasswordVault/WebServices/PIMServices.svc/Account/:accountDetails/PrivilegedCommands
  body: none
  auth: bearer
}

params:path {
  accountDetails: {AccountAddress}|{AccountUserName}|{AccountPolicyId}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
