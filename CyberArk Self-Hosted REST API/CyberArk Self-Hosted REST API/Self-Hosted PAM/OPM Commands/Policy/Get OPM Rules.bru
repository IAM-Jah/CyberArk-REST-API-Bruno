meta {
  name: Get OPM Rules
  type: http
  seq: 1
}

get {
  url: https://{{PVWAAddress}}/PasswordVault/WebServices/PIMServices.svc/Policy/:policyID/PrivilegedCommands/
  body: none
  auth: bearer
}

params:path {
  policyID: policyID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
