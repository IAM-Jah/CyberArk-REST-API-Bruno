meta {
  name: Add OPM Policy
  type: http
  seq: 2
}

put {
  url: https://{{PVWAAddress}}/PasswordVault/WebServices/PIMServices.svc/Policy/:policyID/PrivilegedCommands
  body: json
  auth: bearer
}

params:path {
  policyID: policyID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

body:json {
  {
  "Command":"<Command>",
  "CommandGroup":<true/false>,
  "PermissionType":"<Allow/Deny>",
  "Restrictions":"<Restrictions>",
  "UserName":"<UserName>"
  }
}
