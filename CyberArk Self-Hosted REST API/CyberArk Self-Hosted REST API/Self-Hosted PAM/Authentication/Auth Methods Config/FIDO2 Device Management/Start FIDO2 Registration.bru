meta {
  name: Start FIDO2 Registration
  type: http
  seq: 3
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/fido2/registrationOptions/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

body:json {
  {
    "UserId": 0
  }
}

docs {
  https://docs.cyberark.com/pam-self-hosted/latest/en/content/webservices/fido2-start-registration.htm
}
