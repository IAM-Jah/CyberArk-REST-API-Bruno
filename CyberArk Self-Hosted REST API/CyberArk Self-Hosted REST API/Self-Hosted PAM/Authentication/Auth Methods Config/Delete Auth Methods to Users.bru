meta {
  name: Delete Auth Methods to Users
  type: http
  seq: 7
}

patch {
  url: https://{{PVWAAddress}}/PasswordVault/API/Users/RemoveAllowedAuthenticationMethods/Bulk
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

body:json {
  {
  "BulkItems": [
    {
     "userIds": ["36", "37"],
     "allowedAuthenticationMethods:  [ "SAML", "PKI"]
    }
   ]
  }
}

docs {
  https://docs.cyberark.com/pam-self-hosted/latest/en/content/webservices/bulk-delete-allowed-auth.htm
}
