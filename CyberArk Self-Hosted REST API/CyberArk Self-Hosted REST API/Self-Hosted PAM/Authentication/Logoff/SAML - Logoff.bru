meta {
  name: SAML - Logoff
  type: http
  seq: 3
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/auth/SAML/Logoff
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

script:post-response {
  bru.setEnvVar("PAMSessionToken","");
}
