meta {
  name: Update User
  type: http
  seq: 6
}

put {
  url: https://{{PVWAAddress}}/passwordvault/api/users/:userID
  body: json
  auth: bearer
}

params:path {
  userID: userIDToUpdate
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

