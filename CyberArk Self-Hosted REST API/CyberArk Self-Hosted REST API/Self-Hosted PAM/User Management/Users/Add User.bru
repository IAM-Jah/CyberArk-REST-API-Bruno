meta {
  name: Add User
  type: http
  seq: 5
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/Users
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

