meta {
  name: Reset User Password
  type: http
  seq: 11
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/Users/:userID/ResetPassword
  body: json
  auth: bearer
}

params:path {
  userID: userIDForReset
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

body:json {
  {
    "id": "userIDToResetPassFor",
    "newPassword": "newPassword"
  }
}
