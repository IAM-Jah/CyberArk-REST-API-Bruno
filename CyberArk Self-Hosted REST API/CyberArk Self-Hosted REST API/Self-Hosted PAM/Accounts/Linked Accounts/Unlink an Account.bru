meta {
  name: Unlink an Account
  type: http
  seq: 2
}

delete {
  url: https://{{PVWAAddress}}/PasswordVault/API/Accounts/:accountID/LinkAccount/:extraPassIndex/
  body: none
  auth: bearer
}

params:path {
  accountID: accountID
  extraPassIndex: 1/2/3
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
