meta {
  name: Link an Account
  type: http
  seq: 1
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/Accounts/:accountID/LinkAccount/
  body: json
  auth: bearer
}

params:path {
  accountID: accountID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

body:json {
  {
  "safe": "linkedAccountSafeName",
  "extraPasswordIndex": <1/2/3>,
  "name": "linkedAccountName",
  "folder" "linkedAccountFolder"
  }
}
