meta {
  name: Get Secret Versions
  type: http
  seq: 5
}

get {
  url: https://{{PVWAAddress}}/PasswordVault/API/Accounts/:accountID/Secret/Versions/
  body: none
  auth: bearer
}

params:query {
  ~showTemporary: True
}

params:path {
  accountID: accountID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
