meta {
  name: Get All Bulk Account Uploads for User
  type: http
  seq: 2
}

get {
  url: https://{{PVWAAddress}}/PasswordVault/API/bulkactions/accounts/
  body: none
  auth: bearer
}

params:query {
  ~filter: status eq failed
  ~limit: 50
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
