meta {
  name: Get Account Group by Safe
  type: http
  seq: 1
}

get {
  url: https://{{PVWAAddress}}/PasswordVault/API/AccountGroups?Safe=safeName/
  body: none
  auth: bearer
}

params:query {
  Safe: safeName/
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
