meta {
  name: Add Account Group
  type: http
  seq: 3
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/AccountGroups/
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

body:json {
  {
  "GroupName": "Windows accounts Group",
  "GroupPlatformID": "WinGroupID",
  "Safe": "Windows accounts Safe"
  }
}
