meta {
  name: Get Account Activity
  type: http
  seq: 4
}

get {
  url: https://{{PVWAAddress}}/PasswordVault/WebServices/PIMServices.svc/Accounts/:accountID/Activities/
  body: none
  auth: bearer
}

params:path {
  accountID: accountID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
