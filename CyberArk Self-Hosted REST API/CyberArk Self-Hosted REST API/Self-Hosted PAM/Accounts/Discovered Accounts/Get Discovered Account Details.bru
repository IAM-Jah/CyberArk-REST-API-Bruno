meta {
  name: Get Discovered Account Details
  type: http
  seq: 3
}

get {
  url: https://{{PVWAAddress}}/PasswordVault/API/DiscoveredAccounts/:accountID/
  body: none
  auth: bearer
}

params:path {
  accountID: accountID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
