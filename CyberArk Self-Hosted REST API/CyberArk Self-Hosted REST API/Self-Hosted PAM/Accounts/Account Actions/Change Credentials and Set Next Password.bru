meta {
  name: Change Credentials and Set Next Password
  type: http
  seq: 12
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/Accounts/:accountID/SetNextPassword/
  body: json
  auth: bearer
}

params:path {
  accountID: accountID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

body:json {
  {
    "ChangeImmediately" : true,
    "NewCredentials": "{{PAMNewPassword}}"
  }
}
