meta {
  name: Generate Password
  type: http
  seq: 7
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/Accounts/:accountID/Secret/Generate/
  body: none
  auth: bearer
}

params:path {
  accountID: accountID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
