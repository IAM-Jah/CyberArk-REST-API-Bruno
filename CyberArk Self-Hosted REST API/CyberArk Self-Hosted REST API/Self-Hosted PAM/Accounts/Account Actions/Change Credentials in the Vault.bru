meta {
  name: Change Credentials in the Vault
  type: http
  seq: 13
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/Accounts/:accountID/Password/Update/
  body: json
  auth: bearer
}

params:path {
  accountID: accountID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

body:json {
  {
    "NewCredentials": "{{PAMNewPassword}}"
  }
}
