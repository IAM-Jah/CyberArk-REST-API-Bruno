meta {
  name: Check In an Exclusive Account
  type: http
  seq: 9
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/Accounts/:accountID/CheckIn/
  body: none
  auth: bearer
}

params:path {
  accountID: accountID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
