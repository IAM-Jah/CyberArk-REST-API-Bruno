meta {
  name: Verify Credentials
  type: http
  seq: 10
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/Accounts/:accountID/Verify/
  body: none
  auth: bearer
}

params:path {
  accountID: accountID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
