meta {
  name: Change Credentials Immediately
  type: http
  seq: 11
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/Accounts/:accountID/Change/
  body: json
  auth: bearer
}

params:path {
  accountID: accountID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

body:json {
  {
    "ChangeEntireGroup" : true
  }
}
