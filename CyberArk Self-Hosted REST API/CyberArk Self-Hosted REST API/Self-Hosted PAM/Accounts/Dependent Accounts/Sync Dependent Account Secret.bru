meta {
  name: Sync Dependent Account Secret
  type: http
  seq: 7
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/Accounts/:accountID/dependentAccounts/:dependentAccountID/Sync
  body: none
  auth: bearer
}

params:path {
  dependentAccountID: {{dependentAccountID}}
  accountID: {{accountName}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

docs {
  https://docs.cyberark.com/pam-self-hosted/latest/en/content/webservices/sync-dependent-account-secret.htm
}
