meta {
  name: Bulk Sync Dependent Account Secret
  type: http
  seq: 8
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/Accounts/:accountID/dependentAccounts/:dependentAccountID/Sync/Bulk
  body: json
  auth: bearer
}

params:path {
  dependentAccountID: {{dependentAccountID}}
  accountID: {{accountName}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

body:json {
  {
    "bulkItems": [
      {
        "accountId": "string",
        "dependentAccountId":"string"
      }
    ]
  }
}

docs {
  https://docs.cyberark.com/pam-self-hosted/latest/en/content/webservices/bulk-sync-dependent-account-secret.htm
}
