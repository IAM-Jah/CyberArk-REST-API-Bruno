meta {
  name: Resume Dependent Account
  type: http
  seq: 9
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/Accounts/:accountID/dependentAccounts/:dependentAccountID/Resume
  body: none
  auth: bearer
}

params:path {
  dependentAccountID: {{dependentAccountID}}
  accountID: {{accountName}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

docs {
  https://docs.cyberark.com/pam-self-hosted/latest/en/content/webservices/resume-dependent-account.htm
}
