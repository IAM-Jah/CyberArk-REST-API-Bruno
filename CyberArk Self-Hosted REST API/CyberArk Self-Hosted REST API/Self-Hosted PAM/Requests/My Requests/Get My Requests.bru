meta {
  name: Get My Requests
  type: http
  seq: 2
}

get {
  url: https://{{PVWAAddress}}/PasswordVault/API/MyRequests?OnlyWaiting=true/false&Expired=true/false
  body: none
  auth: bearer
}

params:query {
  OnlyWaiting: true/false
  Expired: true/false
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
