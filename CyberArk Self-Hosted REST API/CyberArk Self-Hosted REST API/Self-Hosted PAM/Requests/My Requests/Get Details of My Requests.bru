meta {
  name: Get Details of My Requests
  type: http
  seq: 3
}

get {
  url: https://{{PVWAAddress}}/PasswordVault/API/myrequests/:requestID
  body: none
  auth: bearer
}

params:path {
  requestID: requestID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
