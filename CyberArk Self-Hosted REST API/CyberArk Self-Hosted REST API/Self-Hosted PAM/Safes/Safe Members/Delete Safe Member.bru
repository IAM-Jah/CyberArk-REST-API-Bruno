meta {
  name: Delete Safe Member
  type: http
  seq: 3
}

delete {
  url: https://{{PVWAAddress}}/PasswordVault/API/Safes/:safeID/Members/:memberName
  body: none
  auth: bearer
}

params:path {
  safeID: safeID
  memberName: memberName
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
