meta {
  name: Get All Safe Members
  type: http
  seq: 5
}

get {
  url: https://{{PVWAAddress}}/PasswordVault/API/Safes/:safeID/Members/
  body: none
  auth: bearer
}

params:query {
  ~filter: memberType eq user
  ~search: searchTerms
  ~offset: 0
  ~limit: 25
  ~sort: asc
}

params:path {
  safeID: safeID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
