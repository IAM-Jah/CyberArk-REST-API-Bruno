meta {
  name: Get All Safes
  type: http
  seq: 5
}

get {
  url: https://{{PVWAAddress}}//PasswordVault/API/Safes/
  body: none
  auth: bearer
}

params:query {
  ~search: searchTerms
  ~offset: 0
  ~limit: 25
  ~sort: safeName desc
  ~includeAccounts: True
  ~extendedDetails: False
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
