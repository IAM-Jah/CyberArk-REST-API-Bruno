meta {
  name: Get Active Session Activities
  type: http
  seq: 3
}

get {
  url: https://{{PVWAAddress}}/PasswordVault/API/livesessions/:liveSessionID/activities/
  body: none
  auth: bearer
}

params:path {
  liveSessionID: liveSessionID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
