meta {
  name: Get Active Session Properties
  type: http
  seq: 4
}

get {
  url: https://{{PVWAAddress}}/PasswordVault/API/livesessions/:liveSessionID/properties/
  body: none
  auth: bearer
}

params:path {
  liveSessionID: liveSessionID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
