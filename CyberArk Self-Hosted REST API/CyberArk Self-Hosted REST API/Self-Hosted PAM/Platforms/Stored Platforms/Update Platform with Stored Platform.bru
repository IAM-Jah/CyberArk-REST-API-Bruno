meta {
  name: Update Platform with Stored Platform
  type: http
  seq: 3
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/Platforms/:platformID/Update
  body: none
  auth: bearer
}

params:path {
  platformID: {{platformID}}
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}

docs {
  https://docs.cyberark.com/pam-self-hosted/latest/en/content/webservices/updateplatformwithstoredplatform.htm
}
