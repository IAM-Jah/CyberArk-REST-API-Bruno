meta {
  name: Get Platform Details
  type: http
  seq: 2
}

get {
  url: https://{{PVWAAddress}}/PasswordVault/API/Platforms/:platformName/
  body: none
  auth: bearer
}

params:path {
  platformName: platformName
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
