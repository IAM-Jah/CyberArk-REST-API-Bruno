meta {
  name: Deactivate Group Platform
  type: http
  seq: 4
}

post {
  url: https://{{PVWAAddress}}/PasswordVault/API/platforms/groups/:platformID/deactivate/
  body: none
  auth: bearer
}

params:path {
  platformID: platformID
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
