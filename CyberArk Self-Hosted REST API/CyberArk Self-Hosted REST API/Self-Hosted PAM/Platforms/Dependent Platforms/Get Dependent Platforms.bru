meta {
  name: Get Dependent Platforms
  type: http
  seq: 1
}

get {
  url: https://{{PVWAAddress}}/PasswordVault/API/platforms/dependents/
  body: none
  auth: bearer
}

params:query {
  ~search: platformName
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{PAMSessionToken}}
}
